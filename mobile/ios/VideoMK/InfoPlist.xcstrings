    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "videomk uses the microphone only while you hold dictation on, so you can say what video you want instead of typing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "videomk usa el micrófono solo mientras mantienes activado el dictado, para que puedas decir qué video quieres en lugar de escribirlo."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "videomk turns your speech into text for your video brief. Where your iPhone supports it, this happens on the device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "videomk convierte tu voz en texto para la descripción de tu video. Si tu iPhone lo admite, esto ocurre en el dispositivo."
          }
        }
      }
    }
  },
  "version" : "1.0"
