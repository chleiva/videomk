: "w", "draw": "circuit", "zone": "bottom", "size": "l", "say": "draad"}, {"id": "wl", "write": "elektronen", "tool": "pen", "near": "w", "side": "below", "size": "s", "say": "die"}, {"id": "bu", "draw": "light_bulb", "zone": "right", "size": "l", "say": "stroom"}, {"id": "a3", "connect": "arrow", "from": "w", "to": "bu", "color": "orange", "say": "elektrische"}], "board": "same"}}}, {"id": "403463f5", "narration": "Aan de andere kant, de positieve pool, worden de elektronen opgenomen. Dat heet reductie. Daar eindigt hun reis.", "scene": {"type": "whiteboard", "props": {"items": [{"id": "t3", "write": "Reductie: elektronen op", "tool": "marker", "ink": "green", "zone": "top-row", "size": "l", "say": "positieve"}, {"id": "p", "draw": "magnet_attract", "zone": "right", "size": "l", "say": "opgenomen"}, {"id": "pl", "write": "plus-pool", "tool": "pen", "near": "p", "side": "below", "size": "s", "say": "reductie"}, {"id": "e", "draw": "person_walking", "zone": "left", "size": "m", "say": "reis"}, {"id": "a4", "connect": "arrow", "from": "e", "to": "p", "color": "blue"}]}}}, {"id": "1ae14ac6", "narration": "Ondertussen zorgt een zoutbrug of vloeistof tussen de cellen voor evenwicht. Zonder die verbinding stopt de reactie meteen.", "scene": {"type": "whiteboard", "props": {"items": [{"id": "z", "write": "zoutbrug", "tool": "marker", "ink": "orange", "zone": "centre", "size": "m", "say": "zoutbrug"}, {"id": "br", "draw": "bridge", "zone": "bottom", "size": "l", "say": "verbinding"}, {"id": "st", "draw": "stop_sign", "zone": "bottom-left", "size": "m", "say": "stopt"}, {"id": "bx", "mark": "box", "on": "z", "color": "red", "say": "meteen"}], "board": "same"}}}, {"id": "dc03ebc1", "narration": "Is de chemische stof op, dan stopt de stroom. Onthoud dit: een batterij zet opgeslagen chemische energie om in elektrische energie.", "scene": {"type": "whiteboard", "props": {"items": [{"id": "bt", "draw": "battery", "zone": "top-left", "size": "m", "say": "stroom"}, {"id": "em0_bt",