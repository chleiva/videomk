---
// The app's landing page, written once for both languages (/ and /es/).
import BaseLayout from "../layouts/BaseLayout.astro";
import PromptForm from "./PromptForm";
import ConsentToast from "./ConsentToast";
import { translate } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
const tr = (k: string) => translate(k, locale);
---
<BaseLayout title="videomk" description={tr("meta.description")} locale={locale} alternates={true}>
	<script define:vars={{ here: locale }}>window.__vmkLanding = here;</script>
	<script>
		import { getTokensIfAvailable } from "../lib/auth";
		import { getLocale } from "../lib/i18n";
		const here = (window as unknown as { __vmkLanding?: string }).__vmkLanding;
		// A Spanish browser (or a saved Spanish choice) lands on /es/; the switcher in the footer remembers the opposite choice.
		if (here === "en" && getLocale() === "es") location.replace("/es/");
		else getTokensIfAvailable().then((t) => { if (t) location.replace("/generations/index.html"); }).catch(() => {});
	</script>
	<section class="mx-auto flex min-h-[70vh] max-w-5xl flex-col items-center justify-center px-6 text-center">
		<h1 class="text-balance text-3xl font-semibold tracking-tight text-neutral-900 md:text-5xl">
			{tr("landing.heading")} <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-pink-500">video</span><span class="font-black">mk</span>
		</h1>
		<div class="mt-8 w-full">
			<PromptForm locale={locale} client:idle />
		</div>
	</section>
	<ConsentToast locale={locale} client:idle />
</BaseLayout>
