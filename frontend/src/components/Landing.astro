---
// The app's landing page, written once for both languages (/ and /es/).
import MarketingLayout from "../layouts/MarketingLayout.astro";
import PromptForm from "./PromptForm";
import ConsentToast from "./ConsentToast";
import { translate } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
const { locale } = Astro.props as { locale: Locale };
const tr = (k: string) => translate(k, locale);
---
<MarketingLayout title="videomk" description={tr("meta.description")} locale={locale} alternates={true}>
	<script define:vars={{ here: locale }}>window.__vmkLanding = here;</script>
	<script>
		import { getTokensIfAvailable } from "../lib/auth";
		import { getLocale } from "../lib/i18n";
		const here = (window as unknown as { __vmkLanding?: string }).__vmkLanding;
		// A Spanish browser (or a saved Spanish choice) lands on /es/; the switcher in the footer remembers the opposite choice.
		if (here === "en" && getLocale() === "es") location.replace("/es/");
		else getTokensIfAvailable().then((t) => { if (t) location.replace("/generations"); }).catch(() => {});
	</script>
	<section class="hero">
		<div class="hero-in">
			<h1 class="hero-title">{tr("landing.heading")} <span class="hero-brand">video</span><span class="hero-brand hero-brand-bold">mk</span></h1>
			<p class="hero-sub">{tr("landing.sub")}</p>
			<div class="mt-8 w-full">
				<PromptForm locale={locale} client:idle />
			</div>
		</div>
	</section>
	<section class="page" aria-labelledby="how-title">
		<h2 id="how-title" class="h2 text-center">{tr("landing.how_title")}</h2>
		<ol class="steps">
			{[1, 2, 3].map((n) => (
				<li class="card step">
					<span class="step-n" aria-hidden="true">{n}</span>
					<h3 class="font-bold">{tr(`landing.step${n}_title`)}</h3>
					<p class="muted">{tr(`landing.step${n}_body`)}</p>
				</li>
			))}
		</ol>
	</section>
	<ConsentToast locale={locale} client:idle />
