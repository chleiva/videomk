---
// One layout for every legal page: a title, a short "at a glance" list, then numbered sections.
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPANY, CONTACT_EMAIL, COMPANY_ADDRESS, COMPANY_NUMBER, ICO_REFERENCE } from "../data/legal";
import type { Section } from "../data/legal/types";
import { pathForLocale, translate } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
interface Props { locale?: Locale; title: string; intro: string; effective: string; glance: string[]; sections: Section[] }
const { locale = "en", title, intro, effective, glance, sections } = Astro.props;
const tr = (key: string, params?: Record<string, string | number>) => translate(key, locale, params);
---
<BaseLayout title={tr("legal.page_title", { title })} description={intro} locale={locale} alternates={true}>
	<article class="page page-narrow legal">
		<a href={pathForLocale("/", locale)} class="caption underline underline-offset-4">{tr("legal.back")}</a>
		<h1 class="h1 mt-6">{title}</h1>
		<p class="mt-3 text-fg leading-7">{intro}</p>
		<p class="mt-3 flex flex-wrap gap-2 text-sm text-fg2">
			<span class="badge badge-neutral !whitespace-normal">{tr("legal.updated", { date: effective })}</span>
			<span class="badge badge-neutral !whitespace-normal">{COMPANY_NUMBER ? tr("legal.provider_number", { company: COMPANY, number: COMPANY_NUMBER }) : tr("legal.provider", { company: COMPANY })}</span>
			<span class="badge badge-neutral !whitespace-normal">ICO: {ICO_REFERENCE}</span>
			{COMPANY_ADDRESS && <span class="badge badge-neutral !whitespace-normal">{COMPANY_ADDRESS}</span>}
			<span class="badge badge-neutral !whitespace-normal">{tr("legal.contact", { email: CONTACT_EMAIL })}</span>
		</p>
		<section class="mt-8 card px-6 py-5">
			<h2 class="text-base font-semibold text-fg">{tr("legal.glance")}</h2>
			<ul class="mt-3 list-disc space-y-2 pl-5 text-fg">{glance.map((g) => <li>{g}</li>)}</ul>
		</section>
		{sections.map((s, i) => (
			<section class="mt-10" id={`s${i + 1}`}>
				<h2 class="text-xl font-semibold text-fg">{i + 1}. {s.title}</h2>
				{(s.paras ?? []).map((p) => <p class="mt-3 text-fg leading-7">{p}</p>)}
				{s.bullets && <ul class="mt-3 list-disc space-y-2 pl-5 text-fg leading-7">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
				{s.table && (
					<div class="mt-3 overflow-x-auto card-flat">
						<table class="w-full min-w-[34rem] border-collapse text-left text-sm text-fg">
							<thead class="bg-surface2 text-fg"><tr>{s.table.head.map((h) => <th scope="col" class="px-3 py-2 font-semibold">{h}</th>)}</tr></thead>
							<tbody>{s.table.rows.map((r) => <tr class="border-t border-line align-top">{r.map((c, ci) => ci === 0 ? <th scope="row" class="px-3 py-2 font-medium text-fg">{c}</th> : <td class="px-3 py-2 leading-6">{c}</td>)}</tr>)}</tbody>
						</table>
					</div>
				)}
				{(s.after ?? []).map((p) => <p class="mt-3 text-fg leading-7">{p}</p>)}
			</section>
		))}
		<p class="mt-12 border-t border-line pt-4 text-sm text-fg2">{tr("legal.english_prevails")}</p>
	</article>
</BaseLayout>
