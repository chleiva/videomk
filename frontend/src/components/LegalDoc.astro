---
// One layout for every legal page: a title, a short "at a glance" list, then numbered sections.
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPANY, CONTACT_EMAIL } from "../data/legal";
export interface Section { title: string; paras?: string[]; bullets?: string[] }
interface Props { title: string; intro: string; effective: string; glance: string[]; sections: Section[] }
const { title, intro, effective, glance, sections } = Astro.props;
---
<BaseLayout title={`${title} — videomk`} description={intro}>
	<article class="mx-auto max-w-3xl px-6 py-14">
		<a href="/" class="text-sm text-neutral-500 underline underline-offset-4 hover:text-neutral-800">← videomk</a>
		<h1 class="mt-6 text-3xl font-semibold tracking-tight text-neutral-900">{title}</h1>
		<p class="mt-3 text-neutral-700 leading-7">{intro}</p>
		<p class="mt-3 flex flex-wrap gap-2 text-xs text-neutral-600">
			<span class="rounded-full border border-neutral-200 bg-white px-3 py-1">Effective {effective}</span>
			<span class="rounded-full border border-neutral-200 bg-white px-3 py-1">Provider: {COMPANY}</span>
			<span class="rounded-full border border-neutral-200 bg-white px-3 py-1">Contact: {CONTACT_EMAIL}</span>
		</p>
		<section class="mt-8 rounded-2xl border border-neutral-200 bg-white px-6 py-5">
			<h2 class="text-base font-semibold text-neutral-900">At a glance</h2>
			<ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700">{glance.map((g) => <li>{g}</li>)}</ul>
		</section>
		{sections.map((s, i) => (
			<section class="mt-10" id={`s${i + 1}`}>
				<h2 class="text-xl font-semibold text-neutral-900">{i + 1}. {s.title}</h2>
				{(s.paras ?? []).map((p) => <p class="mt-3 text-neutral-700 leading-7">{p}</p>)}
				{s.bullets && <ul class="mt-3 list-disc space-y-2 pl-5 text-neutral-700 leading-7">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
			</section>
		))}
	</article>
</BaseLayout>
