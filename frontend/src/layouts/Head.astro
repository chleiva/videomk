---
// <head> shared by both layouts: meta, icons, language alternates, the theme bootstrap (applied before paint so there is no flash).
import { SITE } from "../data/legal";
import { pathForLocale, translate } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
const { title, description, locale, alternates = false, noindex = false, ogImage = "" } = Astro.props as { title: string; description?: string; locale: Locale; alternates?: boolean; noindex?: boolean; ogImage?: string };
const here = (Astro.url.pathname || "/").replace(/index\.html$/, "");
const withSlash = (p: string) => (p.endsWith("/") ? p : p + "/");
const abs = (l: Locale) => `https://${SITE}${withSlash(pathForLocale(here, l))}`;
const desc = description ?? translate("meta.description", locale);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={desc} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{alternates && <link rel="canonical" href={abs(locale)} />}
{alternates && <link rel="alternate" hreflang="en" href={abs("en")} />}
{alternates && <link rel="alternate" hreflang="es" href={abs("es")} />}
{alternates && <link rel="alternate" hreflang="x-default" href={abs("en")} />}
{ogImage && <meta property="og:type" content="website" />}
{ogImage && <meta property="og:site_name" content="VideoMK" />}
{ogImage && <meta property="og:title" content={title} />}
{ogImage && <meta property="og:description" content={desc} />}
{ogImage && <meta property="og:image" content={`https://${SITE}${ogImage}`} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />}
{ogImage && <meta name="twitter:card" content="summary_large_image" />}
{ogImage && <meta name="twitter:image" content={`https://${SITE}${ogImage}`} />}
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f7f7fa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#06070d" media="(prefers-color-scheme: dark)" />
<script is:inline>try{var th=localStorage.getItem("vmk_theme");if(th==="light"||th==="dark")document.documentElement.setAttribute("data-theme",th)}catch(e){}</script>
