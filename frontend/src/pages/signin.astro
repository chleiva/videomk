---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTH_APPLE, AUTH_GOOGLE } from "../lib/config";
import { chooserOptions } from "../lib/authUrl";
const options = chooserOptions({ google: AUTH_GOOGLE, apple: AUTH_APPLE });
---
<BaseLayout title="Sign in · videomk" description="Sign in to videomk.">
	<div class="signin">
		<div class="card" role="group" aria-labelledby="signin-title">
			<h1 id="signin-title">Sign in to video<span>mk</span></h1>
			<p class="sub">Choose how you want to continue.</p>
			<div class="buttons">
				{options.map((o) => (
					<button type="button" class={`btn btn-${o.id}`} data-provider={o.id} aria-label={o.label}>
						{o.id === "google" && (
							<svg class="ico" viewBox="0 0 48 48" width="18" height="18" aria-hidden="true" focusable="false">
								<path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
								<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
								<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
								<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
							</svg>
						)}
						{o.id === "apple" && (
							<svg class="ico" viewBox="0 0 814 1000" width="17" height="20" aria-hidden="true" focusable="false">
								<path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/>
							</svg>
						)}
						{o.id === "email" && (
							<svg class="ico" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7.5 8 6 8-6"/>
							</svg>
						)}
						<span>{o.label}</span>
					</button>
				))}
			</div>
			<p id="signin-error" class="err" role="alert" hidden></p>
			<p class="fine">See our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
		</div>
	</div>
	<script>
		import { beginAuthorize, getTokensIfAvailable, pendingReturnPath } from "../lib/auth";
		import { COGNITO_PROVIDER } from "../lib/authUrl";

		getTokensIfAvailable().then((t) => { if (t) location.replace(pendingReturnPath()); }).catch(() => {});
		const err = document.getElementById("signin-error")!;
		document.querySelectorAll<HTMLButtonElement>("button[data-provider]").forEach((b) => {
			b.addEventListener("click", () => {
				const id = b.dataset.provider as "google" | "apple" | "email";
				document.querySelectorAll<HTMLButtonElement>("button[data-provider]").forEach((x) => (x.disabled = true));
				try { sessionStorage.removeItem("vmk_auth_retried"); } catch {}
				beginAuthorize(undefined, id === "email" ? undefined : COGNITO_PROVIDER[id]).catch(() => {
					err.textContent = "Could not start sign-in. Please try again.";
					err.hidden = false;
					document.querySelectorAll<HTMLButtonElement>("button[data-provider]").forEach((x) => (x.disabled = false));
				});
			});
		});
	</script>
</BaseLayout>

<style is:global>
	.signin {
		--bg: #fafafa; --card: #fff; --line: #e5e5e5; --fg: #171717; --muted: #525252; --link: #171717;
		--g-bg: #fff; --g-line: #747775; --g-fg: #1f1f1f; --g-hover: rgba(48,48,48,.08);
		--a-bg: #000; --a-fg: #fff; --a-line: #000; --a-hover: #262626;
		--e-bg: #fff; --e-line: #d4d4d4; --e-fg: #171717; --e-hover: #f5f5f5;
		--focus: #2563eb; --err: #b91c1c;
		display: flex; justify-content: center; align-items: flex-start; padding: 12vh 16px 32px;
	}
	@media (prefers-color-scheme: dark) {
		.signin {
			--bg: #0a0a0a; --card: #171717; --line: #2e2e2e; --fg: #fafafa; --muted: #a3a3a3; --link: #fafafa;
			--g-bg: #131314; --g-line: #8e918f; --g-fg: #e3e3e3; --g-hover: rgba(232,234,237,.1);
			--a-bg: #fff; --a-fg: #000; --a-line: #fff; --a-hover: #e5e5e5;
			--e-bg: #171717; --e-line: #404040; --e-fg: #fafafa; --e-hover: #262626;
			--focus: #60a5fa; --err: #fca5a5;
		}
	}
	html:has(.signin) body { background: #fafafa; color: #171717; }
	@media (prefers-color-scheme: dark) { html:has(.signin) body { background: #0a0a0a; color: #fafafa; } html:has(.signin) footer { color: #a3a3a3; } html:has(.signin) footer a:hover { color: #fafafa; } }
	.signin .card { width: 100%; max-width: 380px; background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 28px 20px 22px; }
	.signin h1 { margin: 0; font-size: 1.5rem; font-weight: 650; letter-spacing: -0.02em; color: var(--fg); text-align: center; }
	.signin h1 span { font-weight: 900; }
	.signin .sub { margin: 6px 0 22px; text-align: center; color: var(--muted); font-size: .95rem; }
	.signin .buttons { display: flex; flex-direction: column; gap: 12px; }
	.signin .btn { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 48px; padding: 0 16px; border-radius: 10px; border: 1px solid; font-size: 15px; font-weight: 500; line-height: 1; cursor: pointer; transition: background-color .15s; }
	.signin .btn:disabled { opacity: .6; cursor: default; }
	.signin .btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
	.signin .btn-google { background: var(--g-bg); border-color: var(--g-line); color: var(--g-fg); font-family: Roboto, "Helvetica Neue", Arial, sans-serif; }
	.signin .btn-google:hover:not(:disabled) { background-image: linear-gradient(var(--g-hover), var(--g-hover)); }
	.signin .btn-apple { background: var(--a-bg); border-color: var(--a-line); color: var(--a-fg); font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif; }
	.signin .btn-apple:hover:not(:disabled) { background: var(--a-hover); }
	.signin .btn-email { background: var(--e-bg); border-color: var(--e-line); color: var(--e-fg); }
	.signin .btn-email:hover:not(:disabled) { background: var(--e-hover); }
	.signin .ico { flex: none; }
	.signin .err { margin: 14px 0 0; color: var(--err); font-size: .9rem; text-align: center; }
	.signin .fine { margin: 18px 0 0; text-align: center; color: var(--muted); font-size: .8rem; }
	.signin .fine a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
	@media (prefers-reduced-motion: reduce) { .signin .btn { transition: none; } }
</style>
