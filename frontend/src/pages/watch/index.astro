---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title={`Watch — videomk`}>
	<section class="mx-auto max-w-5xl px-6 py-10 md:py-16">
		<a href="/generations" class="inline-flex items-center text-sm text-neutral-600 hover:text-neutral-900">
			<span aria-hidden>←</span>
			<span class="ml-1">Back to Generations</span>
		</a>
		<div class="mt-4">
			<div class="ratio-16x9 relative overflow-hidden rounded-2xl border border-neutral-200 bg-black">
				<video id="video" class="ratio-media w-full h-full object-contain" controls playsinline preload="auto">
					<source id="source" type="video/mp4" />
				</video>
			</div>
		</div>
	</section>

	<script is:inline src="/watch.js?v=1"></script>
</BaseLayout>


